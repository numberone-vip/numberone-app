<?xml version="1.0" encoding="utf-8"?>
<!--
  Number One app icon - foreground layer (adaptive icon, safe zone 66dp).
  A bold "N" with soft shadow, a stepped extrusion for weight, a glass face and
  a diagonal glare, plus two signal arcs from the in-app login logo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cast shadow -->
    <group android:translateY="4.2">
        <path android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z" android:fillColor="#1F000000" />
    </group>
    <group android:translateY="3">
        <path android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z" android:fillColor="#26000000" />
    </group>

    <!-- Extrusion (depth) -->
    <group android:translateY="2.4">
        <path android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z" android:fillColor="#FF2E2A82" />
    </group>
    <group android:translateY="1.2">
        <path android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z" android:fillColor="#FF4338CA" />
    </group>

    <!-- Face -->
    <path android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="30"
                android:endX="70"
                android:endY="78">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFE0E7FF" android:offset="0.35" />
                <item android:color="#FFA5B4FC" android:offset="0.75" />
                <item android:color="#FF818CF8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass glare, clipped to the letter -->
    <group>
        <clip-path android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z" />
        <path android:pathData="M30,24 L60,24 L42,84 L30,84 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="38"
                    android:startY="30"
                    android:endX="62"
                    android:endY="62">
                    <item android:color="#66FFFFFF" android:offset="0" />
                    <item android:color="#00FFFFFF" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Crisp edge highlight -->
    <path
        android:pathData="M38,30 H47 L61,56 V30 H70 V78 H61 L47,52 V78 H38 Z"
        android:strokeWidth="0.7"
        android:strokeColor="#99FFFFFF"
        android:fillColor="#00000000" />

    <!-- Signal arcs (radius 26 and 32 around the center) -->
    <path
        android:pathData="M75.55,39.46 A26,26 0,0,1 75.55,68.54"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#CCC7D2FE"
        android:fillColor="#00000000" />
    <path
        android:pathData="M81.71,38 A32,32 0,0,1 81.71,70"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#80818CF8"
        android:fillColor="#00000000" />
</vector>
