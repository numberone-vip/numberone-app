<?xml version="1.0" encoding="utf-8"?>
<!--
  Number One login logo (in-app, drawn on the navy and indigo header).
  A geometric "N" monogram, a hairline frame, and signal arcs that suggest
  live virtual numbers. Designed for a 92dp emblem with 8dp padding.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hairline frame -->
    <path
        android:pathData="M54,14 A40,40 0,1,1 54,94 A40,40 0,1,1 54,14 Z"
        android:strokeWidth="1"
        android:strokeColor="#4D818CF8"
        android:fillColor="#00000000" />

    <!-- Signal arcs on the right -->
    <path
        android:pathData="M72,38 A18,18 0,0,1 72,70"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#B3C7D2FE"
        android:fillColor="#00000000" />
    <path
        android:pathData="M80,30 A30,30 0,0,1 80,78"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeColor="#664F46E5"
        android:fillColor="#00000000" />

    <!-- Live node -->
    <path
        android:pathData="M78,54 m-3.2,0 a3.2,3.2 0,1,0 6.4,0 a3.2,3.2 0,1,0 -6.4,0"
        android:fillColor="#FFE0E7FF" />

    <!-- Geometric "N" (Number One monogram) -->
    <path
        android:pathData="M44,36 H50 L58,54 V36 H64 V72 H58 L50,54 V72 H44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44"
                android:startY="36"
                android:endX="64"
                android:endY="72">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFC7D2FE" android:offset="0.5" />
                <item android:color="#FF818CF8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
