<?xml version="1.0" encoding="utf-8"?>
<!--
  Number One app icon - background layer.
  Deep navy to indigo base, a soft light bloom, a bottom vignette for weight,
  two hairline rings and a corner sheen for a machined, premium surface.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF070B18" android:offset="0" />
                <item android:color="#FF1E1B4B" android:offset="0.5" />
                <item android:color="#FF4338CA" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Light bloom, top left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="26"
                android:gradientRadius="78">
                <item android:color="#66818CF8" android:offset="0" />
                <item android:color="#00818CF8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom vignette -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="52"
                android:endX="0"
                android:endY="108">
                <item android:color="#00000000" android:offset="0" />
                <item android:color="#73000000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hairline rings -->
    <path
        android:pathData="M54,8 A46,46 0,1,1 54,100 A46,46 0,1,1 54,8 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#26C7D2FE"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,-4 A58,58 0,1,1 54,112 A58,58 0,1,1 54,-4 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#16C7D2FE"
        android:fillColor="#00000000" />

    <!-- Corner sheen -->
    <path
        android:pathData="M0,0 L62,0 L0,62 Z"
        android:fillColor="#0DFFFFFF" />
</vector>
